<Window Title="Qr Code Generator" Width="1000" Height="420">
	<HBox Spacing="16" Slot.HAlign="Fill" Slot.VAlign="Fill">
		<VBox Spacing="8">
			<Label Text="Qr Code Generator" TextSize="20" TextAlign="Center"/>
			<VBox Spacing="4">
				<Label Text="Text or Link:" TextSize="18"/>
				<TextInput Placeholder="Enter URL or text ..." Name="input_text"/>
			</VBox>
			<VBox Spacing="8">
				<Label Text="Error Correction Level:" TextSize="18"/>
				<HBox Spacing="8">
					<Checkbox Text="Low" Name="low" OnChanged="on_ecc_toggled"/>
					<Checkbox Text="Medium" Name="med" OnChanged="on_ecc_toggled"/>
					<Checkbox Text="Quartile" Name="qua" OnChanged="on_ecc_toggled"/>
					<Checkbox Text="High" Name="high" Checked="true" OnChanged="on_ecc_toggled"/>
				</HBox>
			</VBox>
			<HBox Spacing="8" Slot.HAlign="Left">
				<Label Text="Border: " TextSize="18"/>
				<SpinBox Min="1" Max="20" Value="8" Step="1" Name="border"/>
				<Label Text="modules" TextSize="15"/>
			</HBox>
			<HBox Spacing="8" Slot.HAlign="Fill">
				<Label Text="Scale: " TextSize="18"/>
				<Spacer Height="16"/>
				<SpinBox Min="1" Max="20" Value="8" Step="1" Name="scale"/>
				<Label Text="pixels per module" TextSize="15"/>
			</HBox>
			<HBox Spacing="8" Slot.HAlign="Fill">
				<Label Text="Colors:" TextSize="18"/>
				<Spacer Height="16"/>
				<Label Text="Light=" TextSize="15"/>
				<TextInput Placeholder="#FFFFFF" Name="light" Text="#FFFFFF"/>
				<Label Text="Dark=" TextSize="15"/>
				<TextInput Placeholder="#000000" Name="dark" Text="#000000"/>
			</HBox>
			<HBox Spacing="8" Slot.HAlign="Fill">
				<Label Text="Version range:" TextSize="18"/>
				<Spacer Height="16"/>
				<Label Text="Minimum" TextSize="15"/>
				<SpinBox Min="1" Max="40" Value="1" Name="vermin"/>
				<Label Text="Maximum" TextSize="15"/>
				<SpinBox Min="1" Value="40" Max="40" Name="vermax"/>
			</HBox>
			<HBox Spacing="8" Slot.HAlign="Fill">
				<Label Text="Mask pattern:" TextSize="18"/>
				<Spacer Height="16"/>
				<SpinBox Min="-1" Max="7" Value="-1" Name="maskpattern"/>
				<Label Text="(-1 for automatic, 0 to 7 for manual)" TextSize="15"/>
			</HBox>
			<HBox Spacing="8" Slot.HAlign="Fill">
				<Label Text="Boost ECC:" TextSize="18"/>
				<Spacer Height="16"/>
				<Checkbox Name="boostecc"/>
				<Label Text="Increase ECC level within same version" TextSize="15"/>
			</HBox>
			<Button Text="Generate QR" Style="Primary" OnClicked="generate_qr"/>
			<Label Name="status" Text="Enter text, choose options, and generate a QR code." TextSize="14" Wrap="true"/>
		</VBox>
		<VBox Spacing="8" Slot.Fill="1">
			<Label Text="Qr Code Preview" TextSize="20" TextAlign="Center"/>
			<Custom Width="240" Height="240" Name="qr_canvas"/>
			<Button Text="Save QR" Style="Primary" Name="save_qr" OnClicked="save_qr"/>
		</VBox>
	</HBox>
</Window>
